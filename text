<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quiz — Ujian Sekolah</title>
    <link rel="stylesheet" href="src/css/style.css" />
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans">
    <!-- Navbar -->
    <header class="bg-blue-600 text-white shadow-md h-14 flex items-center justify-between px-5 relative">
      <div class="font-bold text-base">Ujian Sekolah</div>
      <nav class="space-x-3 hidden md:block text-sm">
        <a href="#" class="hover:underline">Beranda</a>
        <a href="#" class="hover:underline">Kuis</a>
        <a href="#" class="hover:underline">Nilai</a>
        <a href="#" class="hover:underline">Bantuan</a>
      </nav>
      <!-- Progress bar timer -->
      <div
        class="absolute bottom-0 left-0 h-1 bg-green-400 transition-all duration-1000"
        id="timer-bar"
        style="width: 100%"
      ></div>
    </header>

    <main class="max-w-7xl mx-auto flex flex-col md:flex-row gap-4 p-4">
      <!-- Sidebar (profil) -->
      <aside class="bg-white w-full md:w-64 rounded-lg shadow-md p-4 flex flex-col items-center text-sm">
        <div class="flex flex-col items-center text-center">
          <div
            class="bg-gradient-to-br from-green-400 to-teal-400 text-white font-bold text-xl flex items-center justify-center rounded-full w-16 h-16 mb-2"
          >
            NF
          </div>
          <h3 class="font-semibold">Naufal Fahrezi</h3>
          <p class="text-gray-500 text-xs">XI IPA • Siswa</p>
        </div>

        <div class="w-full mt-3 border-t pt-3 space-y-2">
          <div class="flex justify-between"><span class="text-gray-600">Kelas</span><span>XI IPA 2</span></div>
          <div class="flex justify-between"><span class="text-gray-600">ID Siswa</span><span>20251123</span></div>
          <div class="flex justify-between">
            <span class="text-gray-600">Sisa Waktu</span><span id="time-left">01:00</span>
          </div>
          <div class="flex justify-between"><span class="text-gray-600">Skor</span><span id="score">0</span></div>
        </div>

        <div class="mt-3 text-xs text-gray-500 text-center border-t pt-2">
          Waktu ujian akan habis otomatis setelah 1 menit.
        </div>
      </aside>

      <!-- Area Kuis -->
      <section class="bg-white rounded-lg shadow-md flex-1 p-5 flex flex-col">
        <div class="flex justify-between items-center border-b pb-2 mb-3">
          <div class="font-semibold text-sm md:text-base">
            Soal <span id="q-number">1</span> dari <span id="q-total">3</span>
          </div>
        </div>

        <div id="question-text" class="text-base md:text-lg font-medium mb-4">Memuat soal...</div>

        <div id="choices" class="flex flex-col gap-2 md:gap-3"></div>

        <div class="flex justify-between items-center mt-6 border-t pt-3">
          <div class="space-x-2">
            <button
              id="prev-btn"
              class="border border-blue-300 text-blue-600 text-sm md:text-base px-3 py-2 rounded hover:bg-blue-50"
            >
              Sebelumnya
            </button>
            <button
              id="next-btn"
              class="bg-blue-600 text-white text-sm md:text-base px-3 py-2 rounded hover:bg-blue-700"
            >
              Berikutnya
            </button>
          </div>
          <div class="w-40">
            <div class="text-xs text-gray-500 mb-1">Progress</div>
            <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
              <div id="prog-fill" class="h-full bg-blue-400 w-0 transition-all duration-500"></div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const questions = [
        { id: 1, q: "Ibukota Indonesia adalah?", choices: ["Jakarta", "Bandung", "Medan", "Surabaya"], answer: 0 },
        { id: 2, q: "2 + 2 = ?", choices: ["3", "4", "22", "5"], answer: 1 },
        { id: 3, q: "Planet terdekat ke Matahari?", choices: ["Bumi", "Mars", "Merkurius", "Venus"], answer: 2 },
      ];

      let current = 0;
      const userAnswers = new Array(questions.length).fill(null);
      const qTotalEl = document.getElementById("q-total");
      const qNumberEl = document.getElementById("q-number");
      const qTextEl = document.getElementById("question-text");
      const choicesEl = document.getElementById("choices");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const scoreEl = document.getElementById("score");
      const progFill = document.getElementById("prog-fill");
      const timeLeftEl = document.getElementById("time-left");
      const timerBar = document.getElementById("timer-bar");

      qTotalEl.textContent = questions.length;

      function renderQuestion(i) {
        const data = questions[i];
        qNumberEl.textContent = i + 1;
        qTextEl.textContent = data.q;
        choicesEl.innerHTML = "";

        data.choices.forEach((c, idx) => {
          const div = document.createElement("div");
          div.className = `border px-4 py-2 rounded-lg cursor-pointer text-sm md:text-base hover:bg-blue-50 ${
            userAnswers[i] === idx ? "bg-blue-100 border-blue-400" : "border-gray-300"
          }`;
          div.textContent = c;
          div.addEventListener("click", () => {
            userAnswers[i] = idx;
            renderQuestion(i);
            updateScorePreview();
          });
          choicesEl.appendChild(div);
        });

        prevBtn.disabled = i === 0;
        nextBtn.textContent = i === questions.length - 1 ? "Selesai" : "Berikutnya";
        updateProgress();
      }

      function updateProgress() {
        const answeredCount = userAnswers.filter((x) => x !== null).length;
        const percent = Math.round((answeredCount / questions.length) * 100);
        progFill.style.width = percent + "%";
      }

      prevBtn.addEventListener("click", () => {
        if (current > 0) {
          current--;
          renderQuestion(current);
        }
      });
      nextBtn.addEventListener("click", () => {
        if (current < questions.length - 1) {
          current++;
          renderQuestion(current);
        } else finishQuiz();
      });

      function updateScorePreview() {
        let s = 0;
        userAnswers.forEach((ua, i) => {
          if (ua === questions[i].answer) s++;
        });
        scoreEl.textContent = s;
      }

      function finishQuiz() {
        let s = 0;
        userAnswers.forEach((ua, i) => {
          if (ua === questions[i].answer) s++;
        });
        alert(`Waktu habis atau ujian selesai! Skor Anda: ${s}/${questions.length}`);
      }

      // Timer 1 menit
      let totalTime = 60; // detik
      const totalWidth = 100; // %
      const timer = setInterval(() => {
        totalTime--;
        const percent = (totalTime / 60) * totalWidth;
        timerBar.style.width = percent + "%";

        const mm = String(Math.floor(totalTime / 60)).padStart(2, "0");
        const ss = String(totalTime % 60).padStart(2, "0");
        timeLeftEl.textContent = mm + ":" + ss;

        if (totalTime <= 0) {
          clearInterval(timer);
          timerBar.style.width = "0%";
          finishQuiz();
        }
      }, 1000);

      renderQuestion(current);
    </script>
  </body>
</html>
